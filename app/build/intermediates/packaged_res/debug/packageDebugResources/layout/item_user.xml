<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp"
    android:background="@drawable/rounded_corners"
    android:layout_marginBottom="5dp"

    android:gravity="center_vertical">
    <ImageView
        android:id="@+id/profileImageView"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="Profile Image" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_weight="1"
        >
    <TextView
        android:id="@+id/usernameTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="18sp"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/quoteTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="14sp"
        android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/btnFriendRequest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Adaugă în lista de prieteni" />
        <Button
            android:id="@+id/btnShareAnimals"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Partajează Animale"
            android:visibility="gone" />
        <Button
            android:id="@+id/btnAcceptShare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Acceptă partajare"
            android:visibility="gone" />
        <Button
            android:id="@+id/btnCancelShare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Anulează partajare"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
