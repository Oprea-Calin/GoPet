<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/profileImageView"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="Profile Image"
            android:scaleType="centerCrop"
            android:background="@drawable/round_image_border"
            android:padding="4dp" />

        <TextView
            android:id="@+id/usernameTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Username"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/quoteTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A quote that inspires you"
            android:textSize="14sp"
            android:textColor="@color/dark_gray"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnFriendRequest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add friend"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="@color/purple_700"
                    android:textColor="@android:color/white"/>

                <Button
                    android:id="@+id/btnShareAnimals"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Share your pets"
                    android:textSize="12sp"
                    android:visibility="gone"
                    android:backgroundTint="@color/purple_700"
                    android:textColor="@android:color/white"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btnAcceptShare"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Accept share request"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp"
                    android:visibility="gone"
                    android:backgroundTint="@color/purple_700"
                    android:textColor="@android:color/white"/>

                <Button
                    android:id="@+id/btnCancelShare"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cancel sharing"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp"
                    android:visibility="gone"
                    android:backgroundTint="@color/purple_700"
                    android:textColor="@android:color/white"/>

                <Button
                    android:id="@+id/btnRemoveFriend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Delete friend"
                    android:textSize="12sp"
                    android:visibility="gone"
                    android:backgroundTint="@color/purple_700"
                    android:textColor="@android:color/white"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
