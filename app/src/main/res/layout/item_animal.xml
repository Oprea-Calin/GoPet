<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    android:elevation="6dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/animalImageView"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:scaleType="centerCrop"
            android:padding="2dp"
            android:contentDescription="Animal image" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:id="@+id/itemName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Name: "
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/itemAge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Age: "
                android:textColor="@color/black"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/itemBreed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Breed: "
                android:textColor="@color/black"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/itemCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Type: "
                android:textColor="@color/black"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/itemGender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gender: "
                android:textColor="@color/black"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/itemWeight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Weight: "
                android:textColor="@color/black"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/itemReproductiveStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reproductive status: "
                android:textColor="@color/black"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/itemAllergies"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alergies: "
                android:textColor="@color/black"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/itemSharedBy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shared by "
                android:textSize="14sp"
                android:textColor="@android:color/holo_blue_dark"
                android:visibility="gone"
                android:paddingTop="4dp"/>

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
