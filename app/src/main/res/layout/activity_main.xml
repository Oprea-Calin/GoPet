<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/settingsIcon"
        android:layout_width="59dp"
        android:layout_height="53dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@id/logoutImage"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/settings_icon" />

    <ImageView
        android:id="@+id/logoutImage"
        android:layout_width="59dp"
        android:layout_height="53dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/logout" />

    <ImageView
        android:id="@+id/addAnimalButton"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginStart="16dp"
        android:clickable="true"
        android:contentDescription="Add a new pet"
        android:focusable="true"
        android:src="@drawable/addpet"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/addAnimalFormScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:overScrollMode="always"
        android:fillViewport="true"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/addAnimalButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/animalsView">

        <LinearLayout
            android:id="@+id/addAnimalFormLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/animalName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nume"
                android:inputType="text" />

            <EditText
                android:id="@+id/animalBreed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Rasa"
                android:inputType="text" />

            <EditText
                android:id="@+id/animalBirthDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Data nașterii (ZZ/LL/AAAA)"
                android:focusable="false"
                android:clickable="true" />

            <EditText
                android:id="@+id/animalCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Categorie (ex: câine, pisică)"
                android:inputType="text" />

            <EditText
                android:id="@+id/animalReproductiveStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Status reproducere (ex: sterilizat)"
                android:inputType="text" />

            <EditText
                android:id="@+id/animalGender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Sex (mascul/femelă)"
                android:inputType="text" />

            <EditText
                android:id="@+id/animalWeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Greutate (kg)"
                android:inputType="numberDecimal" />

            <EditText
                android:id="@+id/animalAllergies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Alergii (dacă există)"
                android:inputType="text" />

            <ImageView
                android:id="@+id/animalImageView"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center_horizontal" />

            <Button
                android:id="@+id/addImageButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select an image"
                android:layout_gravity="center_horizontal" />

            <Button
                android:id="@+id/addAnimalFormButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add new pet"
                android:layout_gravity="center_horizontal" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/loadingSpinner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/addAnimalFormScrollView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/myAnimalsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="My Animals"
        android:textColor="#333333"
        android:textSize="20sp"
        android:textStyle="bold"
        android:background="@drawable/bg_my_animals_label"
        android:elevation="4dp"
        app:layout_constraintBottom_toTopOf="@+id/animalsView"
        app:layout_constraintStart_toStartOf="parent" />


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/animalsView"
        android:layout_width="0dp"
        android:layout_height="300dp"

        app:layout_constraintBottom_toTopOf="@+id/bottomGrid"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/bottomGrid"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
