<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main"
    tools:context=".MainActivity">


    <ImageView
        android:id="@+id/logoutImage"
        android:layout_width="59dp"
        android:layout_height="53dp"
        android:layout_marginTop="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/logout" />


    <ImageView
        android:id="@+id/viewProfile"
        android:layout_width="59dp"
        android:layout_height="53dp"
        android:layout_marginTop="28dp"
        android:clickable="true"
        android:contentDescription="View profile"
        android:focusable="true"
        android:src="@drawable/outline_face_unlock_24"
        app:layout_constraintEnd_toStartOf="@+id/logoutImage"
        app:layout_constraintHorizontal_bias="0.454"
        app:layout_constraintStart_toStartOf="@+id/btnAllUsers"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/addAnimalButton"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginStart="16dp"
        android:clickable="true"
        android:contentDescription="Add a new pet"
        android:focusable="true"
        android:src="@drawable/addpet"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnPetSitting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pet Sitting"
        app:layout_constraintBottom_toTopOf="@+id/btnFriends"
        app:layout_constraintEnd_toStartOf="@+id/viewProfile" />

    <Button
        android:id="@+id/btnFriends"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Friends"
        app:layout_constraintEnd_toStartOf="@+id/btnAllUsers"
        app:layout_constraintTop_toBottomOf="@+id/viewProfile" />
    <Button
        android:id="@+id/btnAllUsers"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="All users"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logoutImage" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/addAnimalFormScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="always"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/animalsView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnAllUsers">

        <LinearLayout
            android:id="@+id/addAnimalFormLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/animalName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Name"
                android:inputType="text" />

            <EditText
                android:id="@+id/animalBreed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Breed"
                android:inputType="text" />

            <EditText
                android:id="@+id/animalBirthDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="false"
                android:hint="Date of Birth (DD/MM/YYYY)" />

            <EditText
                android:id="@+id/animalCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Type (cat,dog, etc): "
                android:inputType="text" />

            <EditText
                android:id="@+id/animalReproductiveStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Reproductive status"
                android:inputType="text" />

            <EditText
                android:id="@+id/animalGender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Gender"
                android:inputType="text" />

            <EditText
                android:id="@+id/animalWeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Weight"
                android:inputType="numberDecimal" />

            <EditText
                android:id="@+id/animalAllergies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Alergies"
                android:inputType="text" />

            <Button
                android:id="@+id/addImageButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Select image" />

            <Button
                android:id="@+id/addAnimalFormButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Add pet" />

            <ImageView
                android:id="@+id/animalImageView"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center_horizontal" />


        </LinearLayout>
    </androidx.core.widget.NestedScrollView>


    <androidx.core.widget.NestedScrollView
        android:id="@+id/addProfileFormLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/animalsView"
        app:layout_constraintTop_toBottomOf="@+id/addAnimalButton">

        <LinearLayout
            android:id="@+id/addUserFormLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/profileImageView"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:contentDescription="Profile Image" />

            <EditText
                android:id="@+id/usernameEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="User name"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/quoteEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="A quote that inspires you"
                android:textSize="14sp" />

            <Button
                android:id="@+id/selectProfileImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                android:text="Add image" />

            <Button
                android:id="@+id/submitProfileUpdateButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:text="Edit profile" />

        </LinearLayout>
        >
    </androidx.core.widget.NestedScrollView>


    <ProgressBar
        android:id="@+id/loadingSpinner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/addAnimalFormScrollView" />

    <TextView
        android:id="@+id/myAnimalsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_my_animals_label"
        android:clickable="true"
        android:elevation="4dp"
        android:focusable="true"
        android:paddingStart="16dp"
        android:layout_marginTop="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp"
        android:text="My pets"
        android:textColor="#333333"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/animalsView"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/profileRecycleView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toTopOf="@+id/myAnimalsTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnAllUsers" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/usersRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"

        app:layout_constraintBottom_toTopOf="@+id/myAnimalsTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnAllUsers" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/animalsView"
        android:layout_width="0dp"
        android:layout_height="300dp"

        app:layout_constraintBottom_toTopOf="@+id/bottomGrid"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/bottomGrid"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
